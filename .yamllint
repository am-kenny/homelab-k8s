---
extends: default

ignore-from-file: [.gitignore, .yamllintignore]

rules:
  braces:
    max-spaces-inside: 1
  document-start:
    present: true
    ignore: |
      /.github/
      /.yamllint
      /kubernetes/
  line-length: disable
  truthy:
    check-keys: false

  # Required by ansible-lint
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
