#!/bin/sh
set -eu

BOND=bond0
PRIMARY={{ eth_interface }}

# Runs at boot after network-online.target. The kernel rejects a primary
# that is not yet a slave, and ifupdown applies bond-primary too early when
# bond-slaves is none, so we wait for enslavement and set it here instead.
#
# /sys/class/net/$PRIMARY/master exists only while the interface is enslaved,
# so its presence also implies $BOND exists.
i=0
while [ $i -lt 30 ]; do
    if [ -e /sys/class/net/$PRIMARY/master ]; then
        echo "$PRIMARY" > /sys/class/net/$BOND/bonding/primary
        echo "set $PRIMARY as primary slave of $BOND"
        exit 0
    fi
    i=$((i + 1))
    sleep 1
done

echo "$PRIMARY never enslaved to $BOND after 30s" >&2
exit 1
