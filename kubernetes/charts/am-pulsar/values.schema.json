{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "telegram": {
      "type": "object",
      "properties": {
        "chatID": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
        },
        "onEnd": {
          "type": "string",
          "enum": ["edit_in_place", "new_message", "delete", "none"]
        },
        "editOnChange": { "type": "boolean" },
        "pin": { "type": "boolean" }
      }
    },
    "twitch": {
      "type": "object",
      "properties": {
        "channelName": { "type": "string" }
      }
    }
  }
}
