environments:
  default:
    values:
      - instances: ["nurlan", "agent", "rocketleague"]

---

helmDefaults:
  wait: true
  timeout: 300
  atomic: true
  createNamespace: true

---

repositories:
  - name: mojo2600
    url: https://mojo2600.github.io/pihole-kubernetes/
  - name: jameswynn
    url: https://jameswynn.github.io/helm-charts
  - name: k8sgpt
    url: https://charts.k8sgpt.ai/

---

releases:
  - name: cert-manager
    chart: oci://quay.io/jetstack/charts/cert-manager
    version: 1.21.2
    namespace: cert-manager
    values:
      - values/cert-manager.yaml
  - name: certificates
    chart: ./charts/certificates
    namespace: cert-manager
    needs:
      - cert-manager/cert-manager
    # No cert-manager CRDs exist on fresh install
    disableValidationOnInstall: true

  - name: prometheus-operator-crds
    chart: oci://ghcr.io/prometheus-community/charts/prometheus-operator-crds
    version: 32.0.1
    namespace: monitoring
    values:
      - crds:
          annotations:
            # Keep CRDs on release removal
            helm.sh/resource-policy: keep
  - name: kube-prometheus-stack
    chart: oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
    version: 92.10.1
    namespace: monitoring
    needs:
      - monitoring/prometheus-operator-crds
    # No Prometheus operator CRDs exist on fresh install
    disableValidationOnInstall: true
    values:
      - values/kube-prometheus-stack.yaml

  - name: pihole
    chart: mojo2600/pihole
    version: 2.38.0
    namespace: pihole
    values:
      - values/pihole.yaml
{{- range .Values.instances }}
  - name: am-pulsar-{{ . }}
    chart: ./charts/am-pulsar
    namespace: am-pulsar
    values:
      - values/am-pulsar/common.yaml
      - values/am-pulsar/{{ . }}.yaml
{{- end }}
  - name: overleaf
    chart: ./charts/overleaf
    namespace: overleaf
    values:
      - values/overleaf.yaml
  - name: homepage
    chart: jameswynn/homepage
    version: 2.1.0
    namespace: homepage
    values:
      - values/homepage.yaml
  - name: k8sgpt-operator
    chart: k8sgpt/k8sgpt-operator
    version: 0.2.29
    namespace: k8sgpt
  - name: k8sgpt
    chart: ./charts/k8sgpt
    namespace: k8sgpt
    needs:
      - k8sgpt/k8sgpt-operator
    values:
      - values/k8sgpt.yaml
