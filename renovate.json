{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions",
    "customManagers:helmChartYamlAppVersions",
    "group:allNonMajor",
    "schedule:weekends"
  ],
  "timezone": "Europe/Berlin",
  "helm-values": {
    "managerFilePatterns": ["/^kubernetes/values/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["overleafcep/sharelatex"],
      "versioning": "loose"
    }
  ]
}
